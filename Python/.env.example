# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env real no repositório.

# Banco de dados
# Opção 1: URL completa (sobrescreve as variáveis abaixo)
DATABASE_URL=

# Opção 2: parâmetros individuais (usado se DATABASE_URL estiver vazio)
DB_USER=softspend_user
DB_PASS=mudar_em_producao
DB_HOST=localhost
DB_NAME=softspend

# Segurança (use uma chave forte gerada com: openssl rand -hex 32)
SECRET_KEY=mudar_em_producao

# JWT (opcional)
JWT_ISSUER=softspend-api
JWT_AUDIENCE=softspend-mobile

# CORS (origens permitidas, separadas por vírgua)
ALLOWED_ORIGINS=https://softspend.com.br

# Rate limiting (habilitar quando atrás de proxy confiável)
TRUST_PROXY=false

# Documentação OpenAPI (mantenha false em produção)
DOCS_ENABLED=false

# OCR de comprovantes com Google Gemini (opcional)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
OCR_MAX_IMAGE_SIZE=1280
OCR_JPEG_QUALITY=80

# Armazenamento de comprovantes (S3, R2, MinIO, etc.)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_PUBLIC_BASE_URL=
S3_URL_EXPIRACAO=3600
S3_MAX_IMAGEM_LARGURA=5000
S3_MAX_IMAGEM_ALTURA=5000
