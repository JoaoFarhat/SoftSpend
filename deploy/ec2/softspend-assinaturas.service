[Unit]
Description=SoftSpend - conciliação diária das assinaturas com a Apple (docs/assinatura.md §2.7)
Wants=network-online.target
After=network-online.target mysql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/SoftSpend/Python
# Mesmo .env da API (banco e APPLE_*); sem uvicorn e sem rota pública.
EnvironmentFile=/home/ubuntu/SoftSpend/Python/.env
ExecStart=/home/ubuntu/SoftSpend/Python/.venv/bin/python -m services.assinatura_job
StandardOutput=append:/var/log/softspend/assinaturas.log
StandardError=append:/var/log/softspend/assinaturas.log
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
